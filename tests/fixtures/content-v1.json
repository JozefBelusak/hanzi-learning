{
  "activities": [
    {
      "id": "lesson-tones",
      "questions": [
        {
          "id": "tones-level",
          "type": "choice",
          "prompt": "Written-tone check: which tone is high and level?",
          "options": [
            {
              "id": "second",
              "text": "Second tone: á"
            },
            {
              "id": "first",
              "text": "First tone: ā"
            },
            {
              "id": "fourth",
              "text": "Fourth tone: à"
            }
          ],
          "answer": "first",
          "explanation": "The first tone is high and level. The mark ā is a reminder of a level pitch.",
          "hint": "Look for the horizontal tone mark."
        },
        {
          "id": "tones-rising",
          "type": "choice",
          "prompt": "Written-tone check: the mark in chá represents which pattern?",
          "options": [
            {
              "id": "falling",
              "text": "Falling"
            },
            {
              "id": "level",
              "text": "High and level"
            },
            {
              "id": "rising",
              "text": "Rising"
            }
          ],
          "answer": "rising",
          "explanation": "The acute mark á represents the second, rising tone.",
          "hint": "The mark slopes upward."
        },
        {
          "id": "tones-falling",
          "type": "choice",
          "prompt": "Written-tone check: which syllable has a fourth tone?",
          "options": [
            {
              "id": "shi",
              "text": "shì"
            },
            {
              "id": "cha",
              "text": "chá"
            },
            {
              "id": "shui",
              "text": "shuǐ"
            }
          ],
          "answer": "shi",
          "explanation": "The mark ì slopes downward and denotes the fourth tone.",
          "hint": "Find the downward-sloping mark."
        },
        {
          "id": "tones-sandhi",
          "type": "choice",
          "prompt": "In ordinary speech, how is the first tone of nǐ hǎo usually pronounced?",
          "options": [
            {
              "id": "neutral",
              "text": "As a neutral tone"
            },
            {
              "id": "rising",
              "text": "Like a second tone"
            },
            {
              "id": "falling",
              "text": "Like a fourth tone"
            }
          ],
          "answer": "rising",
          "explanation": "Before another third tone, the first third tone normally changes to a rising second tone. Dictionary pinyin still writes nǐ hǎo.",
          "hint": "This phrase places two third tones together.",
          "audioText": "你好"
        },
        {
          "id": "tones-neutral",
          "type": "choice",
          "prompt": "Which description fits a neutral-tone syllable?",
          "options": [
            {
              "id": "level",
              "text": "Always long and high"
            },
            {
              "id": "falling",
              "text": "Always a fourth tone"
            },
            {
              "id": "short",
              "text": "Short and unstressed; pitch depends on context"
            }
          ],
          "answer": "short",
          "explanation": "Neutral tone is not a fixed fifth pitch contour. It is unstressed and changes with context.",
          "hint": "Think of the second syllable in māma.",
          "audioText": "妈妈"
        }
      ],
      "prerequisites": [],
      "practiceWords": [
        "妈妈",
        "你",
        "好",
        "茶",
        "水"
      ]
    },
    {
      "id": "lesson-greetings",
      "questions": [
        {
          "id": "greetings-listen",
          "type": "choice",
          "prompt": "Play the example and choose its meaning.",
          "options": [
            {
              "id": "thanks",
              "text": "Thank you"
            },
            {
              "id": "hello",
              "text": "Hello"
            },
            {
              "id": "bye",
              "text": "Goodbye"
            }
          ],
          "answer": "hello",
          "explanation": "你好 is the greeting “hello”. Its first syllable changes tone before the second third tone.",
          "audioText": "你好",
          "hint": "The two characters literally relate to “you” and “good”."
        },
        {
          "id": "greetings-reply",
          "type": "choice",
          "prompt": "Someone says 谢谢. Which reply means “you are welcome”?",
          "options": [
            {
              "id": "bye",
              "text": "再见",
              "pinyin": "zàijiàn"
            },
            {
              "id": "hello",
              "text": "你好",
              "pinyin": "nǐ hǎo"
            },
            {
              "id": "welcome",
              "text": "不客气",
              "pinyin": "bú kèqi"
            }
          ],
          "answer": "welcome",
          "explanation": "不客气 is a common reply to 谢谢.",
          "hint": "Choose the expression that tells someone there is no need to be polite."
        },
        {
          "id": "greetings-question",
          "type": "order",
          "prompt": "Build: “Are you well?”",
          "tokens": [
            "你",
            "好",
            "吗"
          ],
          "acceptedOrders": [
            [
              "你",
              "好",
              "吗"
            ]
          ],
          "explanation": "The statement 你好 becomes a yes-or-no question when 吗 is added at the end.",
          "hint": "Put the question particle last.",
          "audioText": "你好吗"
        },
        {
          "id": "greetings-ma",
          "type": "choice",
          "prompt": "Where does 吗 go in this kind of yes-or-no question?",
          "options": [
            {
              "id": "end",
              "text": "At the end"
            },
            {
              "id": "start",
              "text": "Before the subject"
            },
            {
              "id": "middle",
              "text": "Between the subject and verb"
            }
          ],
          "answer": "end",
          "explanation": "吗 follows the whole statement. The original word order stays the same.",
          "hint": "Think of 你好吗？"
        },
        {
          "id": "greetings-goodbye",
          "type": "choice",
          "prompt": "Choose the expression for “goodbye”.",
          "options": [
            {
              "id": "thanks",
              "text": "谢谢",
              "pinyin": "xièxie"
            },
            {
              "id": "bye",
              "text": "再见",
              "pinyin": "zàijiàn"
            },
            {
              "id": "welcome",
              "text": "不客气",
              "pinyin": "bú kèqi"
            }
          ],
          "answer": "bye",
          "explanation": "再见 means “goodbye”, literally suggesting seeing someone again.",
          "hint": "It is the expression used when leaving."
        }
      ],
      "prerequisites": [
        "lesson-tones"
      ],
      "practiceWords": [
        "你",
        "好",
        "谢谢",
        "不客气",
        "再见",
        "吗"
      ]
